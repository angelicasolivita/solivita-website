# Copy to .env.local for local development (gitignored, never commit real values).
# In production, set these in Vercel: Project Settings > Environment Variables.
# See GOOGLE-SHEETS-API-SETUP.md for how to generate these.

GOOGLE_SERVICE_ACCOUNT_EMAIL=name@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-the-sheet-url
